# Copia este archivo a .env y pon los valores reales.
# .env esta en .gitignore: NUNCA lo subas al repositorio.

# Clave para firmar los JWT. Minimo 32 caracteres.
# Genera una aleatoria, no uses esta.
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-de-32-o-mas

# URL publica desde donde se sirven las imagenes.
# En desarrollo con emulador Android usa http://10.0.2.2:8080
PUBLIC_BASE_URL=http://localhost:8080
