# Copia este archivo a .env y pon los valores reales.
# .env esta en .gitignore: NUNCA lo subas al repositorio.

# ---------------------------------------------------------------------------
# Imprescindibles
# ---------------------------------------------------------------------------

# Clave para firmar los JWT. Minimo 32 caracteres; si es mas corta el servidor no arranca.
# Genera una aleatoria, no uses esta.
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-de-32-o-mas

# ---------------------------------------------------------------------------
# Opcionales (si no las defines, se usa el valor que va despues del "=" comentado)
# ---------------------------------------------------------------------------

# URL publica desde donde se sirven las imagenes de perfil.
# Con el emulador de Android usa http://10.0.2.2:8080
# PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Google Calendar
# Sin estas cuatro, POST /api/schedules/sync/google responde 503 y el resto
# de la app funciona igual.
# ---------------------------------------------------------------------------

# Credenciales OAuth del proyecto de Google Cloud (con la Calendar API habilitada).
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Solo para flujo web. Las apps nativas (Android, Flutter) no lo usan: dejalo vacio.
GOOGLE_REDIRECT_URI=

# 32 bytes en Base64. Cifra los refresh tokens de Google guardados en la base de datos.
# Si se pierde o se cambia, los usuarios tienen que conectar Google de nuevo.
# Generala una vez y guardala: no la regeneres en cada arranque.
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Analytics (envio de eventos al engine)
# ---------------------------------------------------------------------------

# Pon false si no tienes el engine corriendo y no quieres avisos en el log.
# ANALYTICS_ENABLED=true

# Engine local. Es la URL que ve el BACKEND, no la app: no necesita ser 10.0.2.2.
# ANALYTICS_URL=http://localhost:8000

# Llave de ingesta. Vacia si el engine no tiene llave configurada.
ANALYTICS_INGEST_KEY=